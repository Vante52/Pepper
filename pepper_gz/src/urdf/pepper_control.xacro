<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="controllers_config" default="$(find pepper_gz)/config/controllers.yaml"/>
  <xacro:arg name="initial_positions_config"
             default="$(find pepper_gz)/config/initial_positions.yaml"/>
  <xacro:property name="control_initial_positions"
    value="${xacro.load_yaml('$(arg initial_positions_config)')['initial_positions']}"/>
  <xacro:include filename="pepper_arms_control.xacro"/>

  <xacro:macro name="pepper_position_joint"
               params="name initial_position:=0.0 initial_velocity:=0.0">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial_position}</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">${initial_velocity}</param>
      </state_interface>
    </joint>
  </xacro:macro>

  <xacro:macro name="pepper_passive_joint" params="name">
    <joint name="${name}">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="PepperGazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:pepper_position_joint name="HipRoll"
      initial_position="${control_initial_positions['HipRoll']}"/>
    <xacro:pepper_position_joint name="HipPitch"
      initial_position="${control_initial_positions['HipPitch']}"/>
    <xacro:pepper_position_joint name="KneePitch"
      initial_position="${control_initial_positions['KneePitch']}"/>
    <xacro:pepper_position_joint name="HeadYaw"
      initial_position="${control_initial_positions['HeadYaw']}"/>
    <xacro:pepper_position_joint name="HeadPitch"
      initial_position="${control_initial_positions['HeadPitch']}"/>

    <xacro:pepper_arm_control prefix="L" initial_positions="${control_initial_positions}"/>
    <xacro:pepper_arm_control prefix="R" initial_positions="${control_initial_positions}"/>

    <xacro:pepper_passive_joint name="LHand"/>
    <xacro:pepper_passive_joint name="RHand"/>
    <xacro:pepper_passive_joint name="WheelFL"/>
    <xacro:pepper_passive_joint name="WheelFR"/>
    <xacro:pepper_passive_joint name="WheelB"/>
  </ros2_control>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_config)</parameters>
      <hold_joints>true</hold_joints>
    </plugin>
  </gazebo>
</robot>
