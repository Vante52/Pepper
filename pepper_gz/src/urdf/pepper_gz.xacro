<?xml version="1.0"?>
<robot name="pepper" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find pepper_description)/urdf/pepper_robot.xacro"/>
  <xacro:include filename="pepper_sensors.xacro"/>
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/pepper/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
