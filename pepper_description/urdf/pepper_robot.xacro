<?xml version="1.0" ?>
<robot name="Pepper" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:arg name="base_link_height" default="0.602"/>
	<xacro:property name="base_link_height" value="$(arg base_link_height)"/>
	<xacro:property name="base_ground_clearance" value="0.334"/>
	<xacro:include filename="pepper_collisions.xacro"/>
	<xacro:include filename="pepper_visuals.xacro"/>
	<xacro:include filename="pepper_head.xacro"/>
	<xacro:include filename="pepper_legs.xacro"/>
	<xacro:include filename="pepper_torso.xacro"/>
	<xacro:include filename="pepper_arms.xacro"/>
	<xacro:include filename="pepper_sensors.xacro"/>
	<xacro:include filename="pepper_fingers.xacro"/>
	<xacro:include filename="pepper_wheels.xacro"/>
</robot>
